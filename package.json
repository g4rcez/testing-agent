{
  "name": "testing-agent",
  "version": "1.2.0",
  "description": "AI-driven browser tests with agent-browser and Jev or Laya decisions",
  "keywords": [
    "agent-browser",
    "ai-testing",
    "browser-automation",
    "jev",
    "laya"
  ],
  "homepage": "https://github.com/g4rcez/testing-agent#readme",
  "bugs": "https://github.com/g4rcez/testing-agent/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g4rcez/testing-agent.git"
  },
  "bin": {
    "agent-browser-jev": "./bin/agent-browser-jev",
    "agent-browser-plugin-jev": "./bin/agent-browser-plugin-jev",
    "agent-tester": "./bin/agent-tester",
    "jev-test": "./bin/jev-test",
    "testing-agent": "./bin/testing-agent"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "schema",
    "examples",
    "tools/laya-server.py",
    "README.md",
    "CONTRIBUTING.md",
    "docs/REFERENCE.md",
    "docs/RELEASE.md",
    "docs/RELEASE-READINESS.md",
    "docs/evidence",
    "docs/assets",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun run schema:generate && bun build src/plugin.ts src/cli.ts src/recorder-daemon.ts --outdir dist --target bun --external zod --external @receptron/laya",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run build && bun test && bun run test:package",
    "serve:giant": "bun run scripts/serve-giant.ts",
    "demo:giant": "bun run scripts/demo-giant.ts",
    "demo:github": "bun run build && bun run scripts/demo.ts --workflow github",
    "demo:wikipedia": "bun run build && bun run scripts/demo.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "prepack": "bun run build",
    "schema:generate": "bun run scripts/generate-schema.ts",
    "test": "bun test tests/unit tests/browser",
    "test:browser": "bun test tests/browser",
    "test:live": "bun run scripts/live.ts",
    "test:mutation": "stryker run",
    "test:package": "bun run scripts/package-smoke.ts",
    "test:unit": "bun test tests/unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@types/bun": "1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fast-check": "^4.10.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-window": "^2.5.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "qs": "6.17.0"
  },
  "peerDependencies": {
    "agent-browser": ">=0.37.0"
  },
  "optionalDependencies": {
    "@receptron/laya": "0.2.0"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
